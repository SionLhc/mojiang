{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "react-jsx",
        "types": [
            "vite/client"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/renderer/src/*"
            ],
            "@shared/*": [
                "src/shared/*"
            ],
            "@mojiang/core": [
                "../../packages/core/src/index.ts"
            ],
            "@mojiang/llm": [
                "../../packages/llm/src/index.ts"
            ]
        },
        "noEmit": true
    },
    "include": [
        "src/renderer/src/**/*.ts",
        "src/renderer/src/**/*.tsx",
        "src/shared/**/*.ts",
        "../../packages/core/src/**/*.ts",
        "../../packages/llm/src/**/*.ts",
        "src/preload/index.d.ts"
    ]
}
