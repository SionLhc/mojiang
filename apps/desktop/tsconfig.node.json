{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "node",
            "electron"
        ],
        "baseUrl": ".",
        "paths": {
            "@main/*": [
                "src/main/*"
            ],
            "@mojiang/core": [
                "../../packages/core/src/index.ts"
            ],
            "@mojiang/llm": [
                "../../packages/llm/src/index.ts"
            ]
        },
        "noEmit": true
    },
    "include": [
        "src/main/**/*.ts",
        "src/preload/**/*.ts",
        "src/shared/**/*.ts",
        "../../packages/core/src/**/*.ts",
        "../../packages/llm/src/**/*.ts",
        "electron.vite.config.ts"
    ]
}
